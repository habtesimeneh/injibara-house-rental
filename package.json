{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "dev:client": "vite",
    "dev:all": "concurrently -k -n server,client -c blue,green \"npm:dev\" \"npm:dev:client\"",
    "build": "vite build && esbuild backend/server.js --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "echo 'No linting configured'",
    "test:smtp": "node test_smtp.mjs"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "@libsql/client": "^0.17.4",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethiopian-calendar-date-converter": "^2.1.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  }
}
