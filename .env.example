# Payment Configuration Placeholders
# These are public payment contact details. Replace with actual values in production .env only.
TELEBIRR_NO=
TELEBIRR_NAME=
CBE_ACCOUNT=
CBE_ACCOUNT_NAME=
ABYSSINIA_ACCOUNT=
ABYSSINIA_ACCOUNT_NAME=
MPESA_ACCOUNT=
MPESA_ACCOUNT_NAME=
AMHARA_ACCOUNT=
AMHARA_ACCOUNT_NAME=

# Yebet Kiray (House Rent) localized error strings (optional overrides).
# Amharic defaults live in client/src/config/yebetKirayErrors.js. Set these to
# override the copy per environment without changing code.
VITE_YEBET_KIRAY_ERR_INCOMPLETE=
VITE_YEBET_KIRAY_ERR_INCOMPLETE_EN=
VITE_YEBET_KIRAY_ERR_PAYMENT_FAILED=
VITE_YEBET_KIRAY_ERR_PAYMENT_FAILED_EN=
VITE_YEBET_KIRAY_ERR_MISSING_INFO=
VITE_YEBET_KIRAY_ERR_MISSING_INFO_EN=
VITE_YEBET_KIRAY_ERR_TIMEOUT=
VITE_YEBET_KIRAY_ERR_TIMEOUT_EN=
VITE_YEBET_KIRAY_ERR_NETWORK=
VITE_YEBET_KIRAY_ERR_NETWORK_EN=

# SMTP Email Configuration (Required for Admin 2FA)
# For Gmail: enable 2FA, then generate an App Password and put it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
