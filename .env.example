# =======================================================
# Injibara House Rental Platform - Environment Configuration
# =======================================================
# This file documents all environment variables used by the application.
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# -------------------------------------------------------
# Server Setup
# -------------------------------------------------------
NODE_ENV=development
PORT=5002
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5002
TRUST_PROXY=1

# -------------------------------------------------------
# Database (MySQL)
# -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=house_rental

# Set to 'true' to allow SQLite fallback when MySQL is unavailable (development only)
ALLOW_SQLITE_FALLBACK=false

# -------------------------------------------------------
# Security & Authentication
# -------------------------------------------------------
# JWT signing secret - MUST be at least 32 characters. Generate a strong random value.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# -------------------------------------------------------
# Admin Credentials (used for env-based admin auth)
# -------------------------------------------------------
ADMIN_EMAIL=your_admin@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_PHONE=+251000000000

# -------------------------------------------------------
# Default Seed Credentials (used when database is empty)
# -------------------------------------------------------
DEFAULT_ADMIN_EMAIL=your_admin@example.com
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password
DEFAULT_ADMIN_PHONE=+251000000000

DEFAULT_LANDLORD_EMAIL=landlord@example.com
DEFAULT_LANDLORD_PASSWORD=change_this_password
DEFAULT_LANDLORD_PHONE=+251000000001

DEFAULT_TENANT_EMAIL=tenant@example.com
DEFAULT_TENANT_PASSWORD=change_this_password
DEFAULT_TENANT_PHONE=+251000000002

# -------------------------------------------------------
# TextBee SMS Gateway Configuration
# -------------------------------------------------------
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id
TEXTBEE_WEBHOOK_SECRET=your_textbee_webhook_secret

# -------------------------------------------------------
# SMTP Email Configuration (Required for Admin 2FA)
# For Gmail: enable 2FA, then generate an App Password.
# -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_email@example.com

# -------------------------------------------------------
# Google Gemini AI Configuration
# -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# -------------------------------------------------------
# Support Contact Information
# -------------------------------------------------------
SUPPORT_PHONE=+251000000000
SUPPORT_EMAIL=support@example.com

# -------------------------------------------------------
# Application URL (used for links in notifications)
# -------------------------------------------------------
APP_URL=http://localhost:5002

# -------------------------------------------------------
# Contact Information (seeded into website settings)
# -------------------------------------------------------
CONTACT_EMAIL=support@example.com
CONTACT_PHONE=+251000000000
CONTACT_TELEGRAM=@YourSupportHandle
CONTACT_INSTAGRAM=your_instagram_handle

# -------------------------------------------------------
# Advertisement Fee Settings
# -------------------------------------------------------
AD_FEE_FEATURED_HOUSE=500
AD_FEE_TENANT_SEEKING=200
AD_FEE_TENANT_CONTACT=150
AD_FEE_BANNER=1000

# -------------------------------------------------------
# Payment Account Details
# -------------------------------------------------------
TELEBIRR_NO=your_telebirr_number
TELEBIRR_NAME=Your Name
CBE_ACCOUNT=your_cbe_account
CBE_ACCOUNT_NAME=Your Name
ABYSSINIA_ACCOUNT=your_abyssinia_account
ABYSSINIA_ACCOUNT_NAME=Your Name
MPESA_ACCOUNT=your_mpesa_account
MPESA_ACCOUNT_NAME=Your Name
AMHARA_ACCOUNT=your_amhara_account
AMHARA_ACCOUNT_NAME=Your Name

# -------------------------------------------------------
# Frontend (Vite) Variables
# -------------------------------------------------------
VITE_SUPPORT_PHONE=+251000000000
VITE_SUPPORT_EMAIL=support@example.com

# -------------------------------------------------------
# Yebet Kiray (House Rent) Localized Error Strings (optional overrides)
# Amharic defaults live in client/src/config/yebetKirayErrors.js
# -------------------------------------------------------
VITE_YEBET_KIRAY_ERR_INCOMPLETE=
VITE_YEBET_KIRAY_ERR_INCOMPLETE_EN=
VITE_YEBET_KIRAY_ERR_PAYMENT_FAILED=
VITE_YEBET_KIRAY_ERR_PAYMENT_FAILED_EN=
VITE_YEBET_KIRAY_ERR_MISSING_INFO=
VITE_YEBET_KIRAY_ERR_MISSING_INFO_EN=
VITE_YEBET_KIRAY_ERR_TIMEOUT=
VITE_YEBET_KIRAY_ERR_TIMEOUT_EN=
VITE_YEBET_KIRAY_ERR_NETWORK=
VITE_YEBET_KIRAY_ERR_NETWORK_EN=

# -------------------------------------------------------
# Docker / Deployment Variables
# -------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# -------------------------------------------------------
# Backup Script Variables
# -------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# -------------------------------------------------------
# Development: Disable HMR (Hot Module Replacement)
# Set to 'true' to disable HMR in development
# -------------------------------------------------------
DISABLE_HMR=false
